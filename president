<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>President Dashboard</title>
    <style>
        /* Global Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background-color: #1f1f23;
            color: white;
            font-family: Arial, sans-serif;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* SIDEBAR */
        .sidebar {
            width: 90px;
            background-color: #8a42ff;
            height: 100vh;
            display: flex;
            flex-direction: column;
            padding-top: 20px;
            align-items: center;
            border-top-right-radius: 25px;
            border-bottom-right-radius: 25px;
            z-index: 100;
        }

        .sidebar .icon {
            width: 60px;
            height: 60px;
            background: #a66cff;
            border-radius: 15px;
            margin: 15px 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .sidebar .icon:hover {
            background-color: #caa4ff;
            transform: scale(1.05);
        }

        .sidebar .logout {
            margin-top: auto;
            margin-bottom: 30px;
        }

        .sidebar .icon.active {
            background-color: #caa4ff;
            transform: scale(1.05);
        }

        /* CONTENT AREA */
        .content {
            flex: 1;
            padding: 40px;
            overflow-y: auto;
        }

        .title {
            font-size: 28px;
            margin-bottom: 20px;
            margin-left: 10px;
        }

        /* DASHBOARD */
        .dashboard-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
        }

        .dashboard-title {
            font-size: 36px;
            margin-bottom: 40px;
            text-align: center;
        }

        .cards-container {
            display: flex;
            gap: 30px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .card {
            background-color: #2b2b31;
            border-radius: 20px;
            padding: 30px;
            width: 250px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card h3 {
            margin-bottom: 20px;
            font-size: 20px;
        }

        .card button {
            background-color: #8a42ff;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .card button:hover {
            background-color: #9a52ff;
            transform: scale(1.05);
        }

        /* TABLE */
        .table-container {
            background-color: #2b2b31;
            padding: 20px;
            border-radius: 20px;
            width: 90%;
            margin-left: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: #3f3f46;
            padding: 15px;
            text-align: left;
            font-size: 15px;
        }

        td {
            padding: 15px;
            border-bottom: 1px solid #444;
            font-size: 15px;
        }

        .check {
            color: #67ff67;
            font-size: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .cross {
            color: #ff6767;
            font-size: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .check:hover {
            color: #9aff9a;
            transform: scale(1.2);
        }

        .cross:hover {
            color: #ff9a9a;
            transform: scale(1.2);
        }

        tr td[colspan="7"] {
            height: 40px; /* empty rows */
        }

        /* ANNOUNCEMENT FORM */
        .form-container {
            background-color: #2b2b31;
            padding: 30px;
            border-radius: 20px;
            width: 90%;
            margin-left: 20px;
            max-width: 600px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #fff;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px;
            border: 1px solid #444;
            border-radius: 10px;
            background-color: #1f1f23;
            color: white;
            font-size: 14px;
            box-sizing: border-box;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            outline: none;
            border-color: #8a42ff;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 30px;
        }

        .cancel-btn,
        .publish-btn {
            padding: 12px 24px;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .cancel-btn {
            background-color: #444;
            color: white;
        }

        .publish-btn {
            background-color: #8a42ff;
            color: white;
        }

        .cancel-btn:hover {
            background-color: #555;
        }

        .publish-btn:hover {
            background-color: #9a52ff;
            transform: scale(1.05);
        }

        /* PAGE MANAGEMENT */
        .page {
            display: none;
        }

        .page.active {
            display: block;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="icon" data-page="dashboard"><span>🔔</span></div>
        <div class="icon" data-page="events"><span>📊</span></div>
        <div class="icon" data-page="announcements"><span>🎤</span></div>
        <div class="icon" data-page="members"><span>👥</span></div>
        <div class="icon logout" data-page="logout"><span>↩️</span></div>
    </div>

    <!-- Dashboard Page -->
    <div class="content page active" id="dashboard">
        <div class="dashboard-container">
            <h1 class="dashboard-title">President Dashboard</h1>
            
            <div class="cards-container">
                <div class="card">
                    <h3>Create Event</h3>
                    <button id="createEventBtn">Create</button>
                </div>

                <div class="card">
                    <h3>Publish Announcement</h3>
                    <button id="publishAnnouncementBtn">Publish</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Events Page -->
    <div class="content page" id="events">
        <h1 class="title">Event Management</h1>

        <div class="table-container">
            <table>
                <tr>
                    <th>Event</th>
                    <th>Date & time</th>
                    <th>Location</th>
                    <th>Max Participants</th>
                    <th>Status</th>
                    <th colspan="2"></th>
                </tr>


                <!-- Empty rows -->
                <tr><td colspan="7"></td></tr>
                <tr><td colspan="7"></td></tr>
                <tr><td colspan="7"></td></tr>
                <tr><td colspan="7"></td></tr>
                <tr><td colspan="7"></td></tr>
            </table>
        </div>
    </div>

    <!-- Announcements Page -->
    <div class="content page" id="announcements">
        <h1 class="title">Publish Announcement</h1>

        <div class="form-container">
            <form id="announcementForm">
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" id="title" name="title" placeholder="Enter announcement title">
                </div>

                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" rows="6" placeholder="Enter your announcement message"></textarea>
                </div>

                <div class="form-group">
                    <label for="priority">Priority</label>
                    <select id="priority" name="priority">
                        <option value="low">Low</option>
                        <option value="medium">Medium</option>
                        <option value="high">High</option>
                        <option value="urgent">Urgent</option>
                    </select>
                </div>

                <div class="form-actions">
                    <button type="button" class="cancel-btn">Cancel</button>
                    <button type="submit" class="publish-btn">Publish Announcement</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Members Page -->
    <div class="content page" id="members">
        <h1 class="title">Members Management</h1>
        
        <div class="table-container">
            <table>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Join Date</th>
                    <th>Status</th>
                    <th colspan="2"></th>
                </tr>

                
                <!-- Empty rows -->
                <tr><td colspan="6"></td></tr>
                <tr><td colspan="6"></td></tr>
                <tr><td colspan="6"></td></tr>
                <tr><td colspan="6"></td></tr>
                <tr><td colspan="6"></td></tr>
            </table>
        </div>
    </div>

    <script>
        // Page Navigation
        const pages = document.querySelectorAll('.page');
        const sidebarIcons = document.querySelectorAll('.sidebar .icon');

        function showPage(pageId) {
            pages.forEach(page => {
                page.classList.remove('active');
            });
            document.getElementById(pageId).classList.add('active');
        }

        sidebarIcons.forEach(icon => {
            icon.addEventListener('click', () => {
                const pageId = icon.getAttribute('data-page');
                
                // Remove active class from all icons
                sidebarIcons.forEach(i => i.classList.remove('active'));
                
                // Add active class to clicked icon
                icon.classList.add('active');
                
                // Show the corresponding page
                showPage(pageId);
            });
        });

        // Dashboard buttons
        document.getElementById('createEventBtn').addEventListener('click', () => {
            sidebarIcons.forEach(i => i.classList.remove('active'));
            document.querySelector('[data-page="events"]').classList.add('active');
            showPage('events');
        });

        document.getElementById('publishAnnouncementBtn').addEventListener('click', () => {
            sidebarIcons.forEach(i => i.classList.remove('active'));
            document.querySelector('[data-page="announcements"]').classList.add('active');
            showPage('announcements');
        });

        // Event approval/rejection
        const acceptBtns = document.querySelectorAll('.accept-btn');
        const rejectBtns = document.querySelectorAll('.reject-btn');

        acceptBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const row = this.parentElement;
                const statusCell = row.querySelector('td:nth-child(5)');

                statusCell.textContent = "approved";
                statusCell.style.color = "#67ff67";

                this.style.opacity = "1";
                row.querySelector('.reject-btn').style.opacity = "0.3";
            });
        });

        rejectBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const row = this.parentElement;
                const statusCell = row.querySelector('td:nth-child(5)');

                statusCell.textContent = "rejected";
                statusCell.style.color = "#ff6767";

                this.style.opacity = "1";
                row.querySelector('.accept-btn').style.opacity = "0.3";
            });
        });

        // Announcement form handling
        const form = document.getElementById('announcementForm');
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const title = document.getElementById('title').value;
            const message = document.getElementById('message').value;
            const priority = document.getElementById('priority').value;
            
            if (title && message) {
                alert('Announcement published successfully!');
                form.reset();
            } else {
                alert('Please fill in all required fields.');
            }
        });

        // Cancel button
        document.querySelector('.cancel-btn').addEventListener('click', function() {
            if (confirm('Are you sure you want to cancel? All changes will be lost.')) {
                form.reset();
                sidebarIcons.forEach(i => i.classList.remove('active'));
                document.querySelector('[data-page="dashboard"]').classList.add('active');
                showPage('dashboard');
            }
        });

        // Logout functionality
        document.querySelector('[data-page="logout"]').addEventListener('click', function() {
            if (confirm('Are you sure you want to logout?')) {
                alert('You have been logged out.');
                // In a real application, you would redirect to login page
            }
        });
    </script>
</body>
</html>
